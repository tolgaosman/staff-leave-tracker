APP_NAME="Staff Leave Tracker"
APP_ENV=production
# Üret: php artisan key:generate --show   (çıktıyı buraya yapıştır)
APP_KEY=
APP_DEBUG=false
# Deploy edilen backend'in genel adresi
APP_URL=https://your-backend-domain.example

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# Production veritabanı (docker-compose'daki 'db' servisiyle uyumlu)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=leave_tracker
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Frontend entegrasyonu ---
# Frontend origin'i (GitHub Pages). Token auth kullanıldığı için tek origin yeterli;
# birden çok origin virgülle: https://kullanici.github.io,https://ornek.com
CORS_ALLOWED_ORIGINS=https://your-username.github.io
SANCTUM_STATEFUL_DOMAINS=your-username.github.io
