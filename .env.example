# Backend REST API kök adresi (lib/api.ts bunu kullanır).
# Yerel geliştirme için Laravel backend'i (staff-leave-tracker-backend) çalıştırın:
#   php artisan serve   ->  http://localhost:8000
# Bu değişken ayarlı değilse lib/api.ts "http://localhost:8000/api" varsayılanına düşer.
#
# CANLI (GitHub Pages) DERLEME: burayı gerçek, herkese açık backend URL'i ile
# geçmelisiniz (CI ortam değişkeni olarak), yoksa yayınlanan site localhost'a
# istek atar ve API'ye ulaşamaz.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
